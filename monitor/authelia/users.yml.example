# Пример того, что установщик создаёт САМ.
#
# Руками этот файл заводить не нужно: install.sh спрашивает пароль, считает
# хеш через саму Authelia и пишет готовый users.yml рядом.
#
# Здесь он лежит только чтобы было видно устройство — и чтобы вы знали, где
# менять пароль потом:
#
#   docker run --rm -it authelia/authelia:4.38 \
#       authelia crypto hash generate argon2
#
# Полученную строку — в поле password, затем перезапустить authelia.

users:
  admin:
    disabled: false
    displayname: 'Владелец'
    # Настоящий хеш начинается с $argon2id$ и содержит параметры и соль.
    # ЗАМЕНИТЕ — установщик подставляет сюда посчитанный.
    password: 'ЗАМЕНИТЕ_ХЕШЕМ'
    email: 'вы@example.com'
    groups:
      - admins
