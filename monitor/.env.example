# Пример. Настоящий .env создаёт install.sh — со случайными секретами и
# правами 600. Этот файл нужен только чтобы понимать, что там внутри.
#
# В репозиторий .env не попадает: см. .gitignore рядом.

SHAPE_DOMAIN=example.com
ACME_EMAIL=you@example.com

# Токен, которым ноды подписывают отправку метрик.
# Права даёт ровно одно: писать в /api/v1/import*. Ни читать, ни удалять.
SHAPE_PUSH_TOKEN=ЗАМЕНИТЕ_СЛУЧАЙНОЙ_СТРОКОЙ

GRAFANA_ADMIN_PASSWORD=ЗАМЕНИТЕ

AUTHELIA_SESSION_SECRET=ЗАМЕНИТЕ
AUTHELIA_STORAGE_ENCRYPTION_KEY=ЗАМЕНИТЕ
AUTHELIA_JWT_SECRET=ЗАМЕНИТЕ
