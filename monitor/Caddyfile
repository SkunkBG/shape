# Три имени, три разных правила доступа.
#
#   push.<домен>     ноды пишут метрики        — токен в заголовке
#   grafana.<домен>  вы смотрите графики       — Authelia, потом вход Grafana
#   auth.<домен>     страница входа Authelia   — открыта по определению
#
# Почему запись НЕ за Authelia: нода не умеет проходить интерактивный вход.
# Значит у неё свой маршрут со своей проверкой, и он должен быть узким —
# ровно один путь, ничего больше.

{
	# Сертификаты Let's Encrypt. Адрес нужен для писем об истечении.
	#
	# Умолчания здесь нет намеренно. Раньше стояло admin@localhost, и когда
	# переменная не доехала до контейнера, Caddy бодро пошёл выпускать
	# сертификаты с этим адресом — а Let's Encrypt его не принимает, потому
	# что в «localhost» нет точки. В логах при этом ругань на домен, и ищешь
	# не там. Пустое значение роняет Caddy сразу и по делу.
	email {$ACME_EMAIL}

	# Каждому клиенту незачем знать, что здесь Caddy и какой версии.
	servers {
		metrics
	}
}

# ── Приём метрик от нод ───────────────────────────────────────────────────
push.{$SHAPE_DOMAIN} {
	# Совпасть должны ОБА условия: и путь, и токен.
	#
	# Путь ограничен намеренно. У VictoriaMetrics по тому же адресу живут
	# и чтение, и удаление рядов (/api/v1/admin/tsdb/delete_series). Открыв
	# сюда всё хранилище, мы отдали бы владельцу токена возможность стереть
	# историю — а токен лежит на 28 нодах и рано или поздно утечёт.
	@push {
		path /api/v1/import*
		method POST
		header Authorization "Bearer {$SHAPE_PUSH_TOKEN}"
	}

	handle @push {
		reverse_proxy victoriametrics:8428
	}

	# Всё остальное — молча и одинаково. Ни подсказки, ни имени продукта:
	# сканеру не с чем работать.
	handle {
		respond 401
	}

	log {
		output file /data/push.log
		format json
	}
}

# ── Страница входа ────────────────────────────────────────────────────────
auth.{$SHAPE_DOMAIN} {
	reverse_proxy authelia:9091
}

# ── Графики ───────────────────────────────────────────────────────────────
grafana.{$SHAPE_DOMAIN} {
	# Первый слой. Неаутентифицированного человека Authelia уводит на свою
	# страницу; до Grafana запрос не доходит вовсе, и снаружи невозможно
	# определить ни то, что за гейтом Grafana, ни её версию.
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
	}

	# Второй слой — собственный вход Grafana. Он остаётся включённым
	# намеренно: гейт защищает от чужих, пароль Grafana — от того, кто
	# как-то оказался внутри периметра.
	reverse_proxy grafana:3000
}
